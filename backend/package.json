{
    "name": "ultra-tool-kit-backend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "extract": "tsx scripts/extract-contract.ts",
        "ingest": "tsx scripts/ingest-catalog.ts",
        "seed-demo": "tsx scripts/seed-demo.ts",
        "catalog:check": "tsx scripts/catalog-check.ts",
        "verify:similarity": "tsx scripts/verify-similarity.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:reset": "drizzle-kit drop && drizzle-kit migrate",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.95.1",
        "@hono/node-server": "^2.0.2",
        "@ultraos/ultra-api-lib": "^1.1.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.12.18",
        "ollama": "^0.6.3",
        "openai": "^6.37.0",
        "pino": "^10.3.1",
        "postgres": "^3.4.9",
        "tree-sitter-cpp": "^0.23.4",
        "web-tree-sitter": "^0.26.8",
        "yaml": "^2.8.4",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@testcontainers/postgresql": "^11.14.0",
        "@types/node": "^25.6.2",
        "drizzle-kit": "^0.31.10",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.5"
    }
}
