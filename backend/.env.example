# ─── Stage A — extractor ─────────────────────────────────────────────────────
# Path to a checkout of `eosio.contracts` (must contain `contracts/<name>/`).
# Resolution order: --source CLI flag → this var → auto-discovery
# (../eosio.contracts, ~/ultra/eosio.contracts, ~/eosio.contracts).
ULTRA_CONTRACTS_PATH=

# Optional path to an `eos` source checkout (reserved for header lookups
# spanning core eosio types; not required for the three primary contracts).
ULTRA_EOS_PATH=

# Chain endpoints used to fetch ABIs (mainnet → testnet fallback).
MAINNET_URL=https://ultra.eosusa.io
TESTNET_URL=https://test.ultra.eosusa.io

# ─── Backend runtime ─────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins. Never use `*`.
ALLOWED_ORIGINS=http://localhost:5172

# Local dev binds to loopback only. Hosted deploys are post-v1.
BIND_HOST=127.0.0.1
BIND_PORT=8787

# ─── Wave W1.5-redo — anonymous backend + per-IP rate limit + monthly cap ─
# Loopback-only ratelimit bypass for local dev (docs/00 §3.5). Setting this
# to `true` short-circuits ALL rate-limit tiers when the remote address is
# 127.0.0.1 or ::1; non-loopback requests still go through the full per-IP
# bucket stack. Committing `DEV_RATELIMIT_BYPASS=true` to any .env* file at
# repo root is a CI failure (scripts/ai-ci-greps.sh grep #5).
DEV_RATELIMIT_BYPASS=

# ─── Wave W4 — read-only chain-RPC tool dispatcher ───────────────────────────
# Comma-separated list of extra host names the W4 tool dispatcher may target
# for read-only chain RPC calls (guidelines §4.2 + §4.6). The baseline
# `*.ultra.io`, `localhost`, and `127.0.0.1` are hardcoded; add any custom
# endpoint hosts the toolkit user expects to call from chat (e.g. a community
# Ultra node). Match is host-exact for entries without a leading `*.`, or
# suffix-match for entries starting with `*.`. DNS rebinding is out of scope
# per §4.6 but the request host is logged on every dispatch.
ALLOWED_CHAIN_HOSTS=

# ─── Wave W5 — eosio.nft.ft action coverage ─────────────────────────────────
# No new env var this wave; ALLOWED_CHAIN_HOSTS still covers the chain
# endpoints the nft.ft tools query (factory.a / group.a / tokenb.a reads go
# through the same get_table_rows / get_balance pipelines that W4 wired in).

# ─── LLM provider abstraction ────────────────────────────────────────────────
# One of: ollama | anthropic. Default is ollama (zero cost, local).
LLM_PROVIDER=ollama

# Ollama (local). Use http://host.docker.internal:11434 from inside Docker.
OLLAMA_BASE_URL=http://localhost:11434
# qwen3:14b is the recommended default — strong JSON / tool-use discipline,
# ~9 GB Q4_K_M, comfortable on a 16 GB+ laptop with other services running.
# Alternatives: mistral-small:24b (best agentic JSON, needs 24 GB+ free),
# qwen3:8b (smaller footprint, weaker on shape discipline).
OLLAMA_CHAT_MODEL=qwen3:14b
# Keep the chat model resident between turns; default is Ollama's own 5-min
# unload, which causes "model unavailable" errors after pauses. Accepts the
# Ollama duration format (s/m/h) or "-1" for never-unload.
OLLAMA_KEEP_ALIVE=30m

# Anthropic (Haiku 4.5). ANTHROPIC_BASE_URL routes through Cloudflare AI
# Gateway when set; leave blank for the default api.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001

# ─── Wave W9 — wallet-native attestation + balance-gated AI ───────────────────
# Minimum UOS balance on the attestation's active account (payload.account)
# required for an ATTESTED caller to use /api/ai-chat. Below it the request is
# refused with { kind: 'refuse', reason: 'insufficient-uos' }. Default 1.0 when
# unset. Set to 0 to DISABLE the balance gate entirely (no RPC read; every
# attested caller passes). Unattested (per-IP) callers are unaffected. See docs/00 §3.7.
BALANCE_THRESHOLD_UOS=

# Optional: pin accepted attestations to a single chainId. When set, an
# attestation whose payload.chainId differs falls through to the per-IP path.
# Leave blank to accept any chainId (origin + exp + signature still bind it).
# See docs/00 §3.7 / docs/proposals/wallet-native-attestation.md §2.4.
ATTESTATION_CHAIN_ID=
