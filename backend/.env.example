# ─── Stage A — extractor ─────────────────────────────────────────────────────
# Path to a checkout of `eosio.contracts` (must contain `contracts/<name>/`).
# Resolution order: --source CLI flag → this var → auto-discovery
# (../eosio.contracts, ~/ultra/eosio.contracts, ~/eosio.contracts).
ULTRA_CONTRACTS_PATH=

# Optional path to an `eos` source checkout (reserved for header lookups
# spanning core eosio types; not required for Phase-1 eosio.token).
ULTRA_EOS_PATH=

# Chain endpoints used to fetch ABIs (mainnet → testnet fallback).
MAINNET_URL=https://ultra.eosusa.io
TESTNET_URL=https://test.ultra.eosusa.io

# ─── Backend runtime ─────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ultra_toolkit

# Comma-separated list of allowed CORS origins. Never use `*`.
ALLOWED_ORIGINS=http://localhost:5172

# Phase-1 single-user mode binds to loopback only. Do not change for Phase 1.
BIND_HOST=127.0.0.1
BIND_PORT=8787

# ─── LLM provider abstraction ────────────────────────────────────────────────
# One of: ollama | anthropic | openai. Phase-1 default is ollama (zero cost).
LLM_PROVIDER=ollama
EMBED_PROVIDER=ollama
CLASSIFIER_PROVIDER=ollama

# Ollama (local). Use http://host.docker.internal:11434 from inside Docker.
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Anthropic (Phase 2). Leave blank in Phase 1.
# ANTHROPIC_BASE_URL routes through Cloudflare AI Gateway when set.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001

# OpenAI (Phase 2 — used for embeddings under the hosted config). Blank in Phase 1.
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
